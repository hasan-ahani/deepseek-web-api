# Copy this file to .env. Sign-in is done by hand in a browser window
# (run `python -m deepseek.auth`), so no DeepSeek credentials are stored here.

# --- Required when serving (deployed/container mode) ---
# Bearer token every /v1 caller must send. Use a long random string.
WEUI_AI_API_KEY=change-me-to-a-long-random-secret

# --- Optional ---
# DEEPSEEK_PROFILE_DIR=session/profile   # reuse an existing signed-in Chrome profile
HOST=127.0.0.1
PORT=8000
RATE_LIMIT_PER_MINUTE=30                 # per-API-key limit on /v1 endpoints
# SERVER_INTERACTIVE_LOGIN=1             # set to 0 in the container (headless)
# SESSION_MAX_AGE=21600                  # seconds a saved session.json stays valid
# DEEPSEEK_BROWSER_ARGS=--no-sandbox --disable-dev-shm-usage
# WEUI_AI_ALLOW_UNAUTH=0                 # local dev only: allow calls without a key
